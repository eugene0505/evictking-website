# EvictKing - Cloudflare Workers Static Assets headers
# NOTE: HSTS is intentionally NOT defined here.
#       It is managed in the Cloudflare dashboard (Batch 2) to avoid conflict.

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Compiled CSS output has no content hash yet -> short cache + revalidate
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

# components.js changes with site edits -> must not be immutable
/components.js
  Cache-Control: public, max-age=300

# No Cache-Control on /* on purpose: HTML keeps the Workers Static Assets default (max-age=0, must-revalidate)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()